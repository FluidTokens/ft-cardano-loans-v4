use cardano/address.{Credential}

pub type ConfigDatum {
  smartTokensSpendScriptHash: ByteArray,
  adminCredential: Credential,
  poolPolicyId: ByteArray,
  requestPolicyId: ByteArray,
  borrowerBondPolicyId: ByteArray,
  lenderBondPolicyId: ByteArray,
  loanPolicyId: ByteArray,
  repaymentPolicyId: ByteArray,
  poolSpendScriptHash: ByteArray,
  requestSpendScriptHash: ByteArray,
  loanSpendScriptHash: ByteArray,
  loanClaimActionScriptHash: ByteArray,
  loanRepayActionScriptHash: ByteArray,
  loanChangeCollateralActionScriptHash: ByteArray,
  loanRecastActionScriptHash: ByteArray,
  assetManagerSpendScriptHash: ByteArray,
  dutchAuctionSpendScriptHash: ByteArray,
  dutchAuctionWithdrawScriptHash: ByteArray,
  dutchAuctionStartingIncreasePerMille: Int,
  dutchAuctionLoweringAmount: Int,
  dutchAuctionLoweringFrequency: Int,
  dutchAuctionMinPriceToCancel: Int,
  poolCancelActionScriptHash: ByteArray,
  poolBorrowActionScriptHash: ByteArray,
  poolSellLenderPositionActionScriptHash: ByteArray,
  poolCompoundActionScriptHash: ByteArray,
  poolManagerSpendScriptHash: ByteArray,
  poolManagerPolicyId: ByteArray,
  lockedBorrowerManagerSpendScriptHash: ByteArray,
  //Index 33: authorizes in-place updates to a pool's terms without burning/reminting its NFT
  poolUpdateActionScriptHash: ByteArray,
}
